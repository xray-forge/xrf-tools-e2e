exports[`docs generate should render ogf.md 1`] = `
[
  "<!-- This file is generated by \`xrf-cli docs generate\`. Do not edit manually. -->",
  "",
  "# OGF commands",
  "",
  "<!-- ANCHOR: commands -->",
  "",
  "## \`xrf-cli ogf fix\`",
  "",
  "Rewrite OGF visuals into well-formed bytes, changing nothing the engine reads",
  "",
  "\`\`\`txt",
  "xrf-cli ogf fix [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to an ogf file or a directory to sweep |",
  "| \`-d, --dest <dest>\` |  |  | Path to the resulting ogf file, defaults to in place rewrite of the source file; not for a directory |",
  "| \`--dry-run\` |  |  | Report what would change and how many bytes would go without writing any file |",
  "| \`-j, --jobs <JOBS>\` |  | \`auto\` | How much of the machine to use: 'auto', a worker count, or a share such as '50%' |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli ogf info\`",
  "",
  "Print what an OGF visual holds",
  "",
  "\`\`\`txt",
  "xrf-cli ogf info [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to the OGF file |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli ogf patch-motion-refs\`",
  "",
  "Rewrite the motion refs of an OGF visual",
  "",
  "\`\`\`txt",
  "xrf-cli ogf patch-motion-refs [OPTIONS] --path <path> --refs <refs>...",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to ogf file |",
  "| \`-d, --dest <dest>\` |  |  | Path to resulting ogf file, defaults to in place rewrite of the source file |",
  "| \`--refs <refs>...\` | yes |  | Motion refs to store in the ogf file |",
  "| \`--dry-run\` |  |  | Validate the rewrite and report the result without writing any file |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli ogf patch-texture-refs\`",
  "",
  "Rename a texture reference of an OGF visual",
  "",
  "\`\`\`txt",
  "xrf-cli ogf patch-texture-refs [OPTIONS] --path <path> --from <from> --to <to>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to ogf file |",
  "| \`-d, --dest <dest>\` |  |  | Path to resulting ogf file, defaults to in place rewrite of the source file |",
  "| \`--from <from>\` | yes |  | Texture reference to rename, matched exactly |",
  "| \`--to <to>\` | yes |  | Texture reference to write in its place |",
  "| \`--dry-run\` |  |  | Validate the change and report the result without writing any file |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli ogf verify\`",
  "",
  "Verify that OGF visuals can be packed for rendering",
  "",
  "\`\`\`txt",
  "xrf-cli ogf verify [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to an ogf file or a directory to sweep |",
  "| \`--root <root>...\` |  |  | Additional root searched for textures after the visual's own tree, repeatable |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "<!-- ANCHOR_END: commands -->",
]
`;

exports[`docs generate should render omf.md 1`] = `
[
  "<!-- This file is generated by \`xrf-cli docs generate\`. Do not edit manually. -->",
  "",
  "# OMF commands",
  "",
  "<!-- ANCHOR: commands -->",
  "",
  "## \`xrf-cli omf duplicate-motion\`",
  "",
  "Copy a motion of an OMF file under a new name",
  "",
  "\`\`\`txt",
  "xrf-cli omf duplicate-motion [OPTIONS] --path <path> --from <from> --to <to>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to omf file |",
  "| \`-d, --dest <dest>\` |  |  | Path to resulting omf file, defaults to in place rewrite of the source file |",
  "| \`--from <from>\` | yes |  | Motion to copy, matched exactly |",
  "| \`--to <to>\` | yes |  | Name to give the copy |",
  "| \`--play-once\` |  |  | Clear looping on the copy so it plays once and ends |",
  "| \`--dry-run\` |  |  | Validate the copy and report the result without writing any file |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli omf filter-motions\`",
  "",
  "Keep only the selected motions of an OMF file",
  "",
  "\`\`\`txt",
  "xrf-cli omf filter-motions [OPTIONS] --path <path> --dest <dest> <--keep <keep>...|--keep-prefix <keep-prefix>...>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to omf file |",
  "| \`-d, --dest <dest>\` | yes |  | Path to resulting omf file |",
  "| \`-k, --keep <keep>...\` |  |  | Exact motion names to keep |",
  "| \`--keep-prefix <keep-prefix>...\` |  |  | Keep motions whose name starts with provided prefix |",
  "| \`--dry-run\` |  |  | Validate the change and report the result without writing any file |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli omf info\`",
  "",
  "Print what an OMF file holds",
  "",
  "\`\`\`txt",
  "xrf-cli omf info [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to the OMF file |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli omf rename-motions\`",
  "",
  "Rename the motions of an OMF file",
  "",
  "\`\`\`txt",
  "xrf-cli omf rename-motions [OPTIONS] --path <path> --dest <dest> --map <map>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to omf file |",
  "| \`-d, --dest <dest>\` | yes |  | Path to resulting omf file |",
  "| \`-m, --map <map>\` | yes |  | Path to JSON object mapping existing motion names to new ones |",
  "| \`--strict\` |  |  | Require every motion in the file to be covered by the map |",
  "| \`--dry-run\` |  |  | Validate the change and report the result without writing any file |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli omf repack\`",
  "",
  "Repack an OMF file, or verify that OMF files repack into the bytes they were read from",
  "",
  "\`\`\`txt",
  "xrf-cli omf repack [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Omf file to repack, or with --verify an omf file or a directory of them |",
  "| \`-d, --dest <dest>\` |  |  | Repacked omf file written |",
  "| \`--verify\` |  |  | Verify that repacked bytes match the source instead of writing them |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "<!-- ANCHOR_END: commands -->",
]
`;

exports[`docs generate should render particle.md 1`] = `
[
  "<!-- This file is generated by \`xrf-cli docs generate\`. Do not edit manually. -->",
  "",
  "# Particle commands",
  "",
  "<!-- ANCHOR: commands -->",
  "",
  "## \`xrf-cli particle find\`",
  "",
  "Find the effects drawing with a texture or shader or running an action, and the groups playing an effect",
  "",
  "\`\`\`txt",
  "xrf-cli particle find [OPTIONS] --path <path> <--texture <texture>|--shader <shader>|--action <action>|--effect <effect>>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to the particle library, particles.xr |",
  "| \`--texture <texture>...\` |  |  | Texture to find the effects sampling, with or without its extension. Repeat to find several |",
  "| \`--shader <shader>...\` |  |  | Shader to find the effects drawing with, such as particles\\add. Repeat to find several |",
  "| \`--action <action>...\` |  |  | Action type to find the effects running, as the unpacked library names it, such as TargetColor. Repeat to find several |",
  "| \`--effect <effect>...\` |  |  | Effect to find the groups playing or spawning it. Repeat to find several |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle info\`",
  "",
  "Print what a particle file holds",
  "",
  "\`\`\`txt",
  "xrf-cli particle info [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to the particle library, particles.xr |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle inspect\`",
  "",
  "Explain one effect or group: its sprite, frames and actions, or the effects it plays and spawns",
  "",
  "\`\`\`txt",
  "xrf-cli particle inspect [OPTIONS] --path <path> <name>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to the particle library, particles.xr |",
  "| \`<name>\` | yes |  | Name of the effect or group, in any case and with either slash, such as explosions\\campfire |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle list\`",
  "",
  "List the effects and groups a particle library holds, with what each draws and plays",
  "",
  "\`\`\`txt",
  "xrf-cli particle list [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Path to the particle library, particles.xr |",
  "| \`--kind <kind>\` |  |  | List only effects or only groups. Possible values: \`effect\`, \`group\`. |",
  "| \`--name <name>\` |  |  | List only names containing this text, in any case and with either slash, such as campfire or explosions\\effects |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle pack\`",
  "",
  "Pack an unpacked particles file folder into one particles.xr",
  "",
  "\`\`\`txt",
  "xrf-cli particle pack [OPTIONS] --path <path> --dest <dest>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Unpacked particles file folder |",
  "| \`-d, --dest <dest>\` | yes |  | Packed particles.xr written |",
  "| \`-f, --force\` |  |  | Replace the destination when it is already there, once the new one is ready |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle repack\`",
  "",
  "Read a particles.xr and write it packed again",
  "",
  "\`\`\`txt",
  "xrf-cli particle repack [OPTIONS] --path <path> --dest <dest>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Packed particles.xr |",
  "| \`-d, --dest <dest>\` | yes |  | Repacked particles.xr written |",
  "| \`-f, --force\` |  |  | Replace the destination when it is already there, once the new one is ready |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle re-unpack\`",
  "",
  "Read an unpacked particles file folder and write it unpacked again",
  "",
  "\`\`\`txt",
  "xrf-cli particle re-unpack [OPTIONS] --path <path> --dest <dest>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Unpacked particles file folder |",
  "| \`-d, --dest <dest>\` | yes |  | Folder the re-unpacked particles file is written to |",
  "| \`-f, --force\` |  |  | Replace the destination when it is already there, once the new one is ready |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle unpack\`",
  "",
  "Unpack a particles.xr into a folder of text files",
  "",
  "\`\`\`txt",
  "xrf-cli particle unpack [OPTIONS] --path <path> --dest <dest>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Packed particles.xr |",
  "| \`-d, --dest <dest>\` | yes |  | Folder the unpacked particles file is written to |",
  "| \`-f, --force\` |  |  | Replace the destination when it is already there, once the new one is ready |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "## \`xrf-cli particle verify\`",
  "",
  "Verify that a particles.xr reads",
  "",
  "\`\`\`txt",
  "xrf-cli particle verify [OPTIONS] --path <path>",
  "\`\`\`",
  "",
  "| Option | Required | Default | Description |",
  "| ------ | -------- | ------- | ----------- |",
  "| \`-p, --path <path>\` | yes |  | Packed particles.xr, or its unpacked folder with --unpacked |",
  "| \`-u, --unpacked\` |  |  | Read the path as an unpacked particles file folder |",
  "| \`-s, --silent\` |  |  | Turn off logging |",
  "| \`-v, --verbose\` |  |  | Turn on verbose logging |",
  "| \`--json\` |  |  | Write the run's JSON report to stdout, moving human output to stderr |",
  "| \`--report <PATH>\` |  |  | Write the run's JSON report to a file |",
  "",
  "<!-- ANCHOR_END: commands -->",
]
`;

