exports[`CLI help tree should expose every domain from root help 1`] = `
{
  "exitCode": 0,
  "stderr": [],
  "stdout": [
    "XRF forge CLI tools application",
    "",
    "Usage: xrf-cli [OPTIONS] [COMMAND]",
    "",
    "Commands:",
    "  archive      X-Ray archive tools",
    "  dds          DDS texture file tools",
    "  dialog       Dialog inspection tools",
    "  docs         CLI documentation tools",
    "  externs      Script extern export tools",
    "  gamedata     Assembled gamedata tools",
    "  level        Compiled level tools",
    "  ltx          LTX configuration tools",
    "  ogf          OGF model tools",
    "  omf          OMF motion tools",
    "  particle     Particle library tools",
    "  profile      Performance measurement tools",
    "  spawn        Spawn file tools",
    "  sprite       Sprite sheet tools",
    "  thm          THM texture metadata tools",
    "  translation  Translation file tools",
    "  help         Print this message or the help of the given subcommand(s)",
    "",
    "Options:",
    "  -s, --silent         Turn off logging",
    "  -v, --verbose        Turn on verbose logging",
    "      --json           Write the run's JSON report to stdout, moving human output to stderr",
    "      --report <PATH>  Write the run's JSON report to a file",
    "  -h, --help           Print help",
    "  -V, --version        Print version",
    "",
    "Environment:",
    "  RUST_LOG  Log filter in env_logger syntax, for example info,wgpu_hal=warn.",
  ],
}
`;

